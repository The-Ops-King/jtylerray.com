{
  "redirects": [
    { "source": "/new-home", "destination": "/", "permanent": true },
    { "source": "/new-home/", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/new-home/index.html" },
    { "source": "/resume", "destination": "/resume.html" },
    { "source": "/work", "destination": "/resume.html" },
    { "source": "/brand-1", "destination": "/brand-1/index.html" },
    { "source": "/brand-1/", "destination": "/brand-1/index.html" },
    { "source": "/card", "destination": "/card/index.html" },
    { "source": "/card/", "destination": "/card/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
