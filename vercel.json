{
  "framework": null,
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/new-home", "destination": "/", "permanent": true },
    { "source": "/new-home/", "destination": "/", "permanent": true },
    { "source": "/resume", "destination": "/", "permanent": true },
    { "source": "/resume/", "destination": "/", "permanent": true },
    { "source": "/resume.html", "destination": "/", "permanent": true },
    { "source": "/work", "destination": "/", "permanent": true },
    { "source": "/apply", "destination": "/", "permanent": true },
    { "source": "/apply/", "destination": "/", "permanent": true },
    { "source": "/real-estate", "destination": "/", "permanent": true },
    { "source": "/real-estate/", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/brand-1", "destination": "/brand-1/index.html" },
    { "source": "/brand-1/", "destination": "/brand-1/index.html" },
    { "source": "/card", "destination": "/card/index.html" },
    { "source": "/card/", "destination": "/card/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
