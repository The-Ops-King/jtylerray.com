{
  "framework": null,
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/new-home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/new-home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/resume/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/resume.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/real-estate",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/real-estate/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/client-onboarding(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/brand-1", "destination": "/brand-1/index.html" },
    { "source": "/brand-1/", "destination": "/brand-1/index.html" },
    { "source": "/card", "destination": "/card/index.html" },
    { "source": "/card/", "destination": "/card/index.html" },
    { "source": "/apply", "destination": "/apply/index.html" },
    { "source": "/apply/", "destination": "/apply/index.html" },
    { "source": "/research", "destination": "/research/index.html" },
    { "source": "/research/", "destination": "/research/index.html" },
    { "source": "/client-onboarding", "destination": "/client-onboarding/index.html" },
    { "source": "/client-onboarding/", "destination": "/client-onboarding/index.html" },
    { "source": "/v/:slug", "destination": "https://yoom.jtylerray.com/v/:slug" },
    { "source": "/v/:slug/:path*", "destination": "https://yoom.jtylerray.com/v/:slug/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
